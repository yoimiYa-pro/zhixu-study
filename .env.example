# Use scripts/init_env.py to create private credentials. Never commit .env.
VITE_JAVA_PROXY_TARGET=http://127.0.0.1:8080
VITE_AI_PROXY_TARGET=http://127.0.0.1:8000
TZ=Asia/Shanghai
POSTGRES_DB=civil_study
POSTGRES_USER=civil_study
POSTGRES_PASSWORD=
REDIS_PASSWORD=
QDRANT_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=
MODEL_CREDENTIALS_KEY=
AI_SERVICE_TOKEN=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=
AI_JSON_MODE=true
AI_PROXY_URL=
# Optional private relay: enable COMPOSE_PROFILES=app,egress and use the actual Docker gateway/CIDR.
EGRESS_BIND_HOST=127.0.0.1
EGRESS_ALLOWED_CIDR=127.0.0.1/32
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=1536
EMBEDDING_SEND_DIMENSIONS=false
EMBEDDING_CHUNK_CHARS=1800
AI_TIMEOUT_SECONDS=60
AI_MAX_ATTEMPTS=3
HTTP_PORT=8088
BUILD_NETWORK=default
DAILY_PLAN_CRON=0 0 5 * * *
NEWS_FETCH_CRON=0 0 6 * * *
NEWS_ANALYZE_CRON=0 30 6 * * *
REVIEW_CHECK_CRON=0 0 20 * * *
WEEKLY_REPORT_CRON=0 0 20 * * SUN
SCHEDULER_ENABLED=true
DAILY_QUESTION_GOAL=20
# Feed URL list, configured by the owner. Empty means no automatic feed configured.
NEWS_FEEDS=
# 支持新华网、央广网、中国政府网的新闻列表；实际 HTTPS 地址，逗号分隔。
NEWS_SITES=
NEWS_LOOKBACK_DAYS=7
NEWS_PROXY_URL=
NEWS_ALLOWED_HOSTS=www.gov.cn,gov.cn,www.news.cn,news.cn,www.people.com.cn,people.com.cn
NEWS_MAX_ARTICLES=10
